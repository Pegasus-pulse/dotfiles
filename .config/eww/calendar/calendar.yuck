(defpoll DATE_HEADER :interval "30s"
  "date +'%A, %d %B'")

(defwidget calendar_widget []
  (box :class "cal-box"
       :orientation "vertical"
       :spacing 5
       :space-evenly false
       :vexpand false
       :valign "start"

    (label :class "cal-header-date"
           :halign "center"
           :text DATE_HEADER
           :vexpand false)

    (calendar :class "cal"
              :vexpand false
              :valign "start")
  )
)

(defwindow calendar_popup
  :monitor 0
  :geometry (geometry :x "0px"
                      :y "33px"
                      :width "300px"
                      :anchor "top center")
  :stacking "fg"
  :exclusive false
  :focusable false
  :windowtype "dock"
  :wm-ignore true
  (calendar_widget))
