
@import	"~/.config/rofi/themes/colors.rasi"

window {
    fullscreen:                  false;
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    width:                       700px;
    x-offset:                    0px;
    y-offset:                    0px;

    enabled:                     true;
    border-radius:               7px;
    background-color:            @bg0;
}

mainbox {
    enabled:                     true;
    orientation:                 vertical;
    spacing:                     0px;
    background-color:            transparent;
    children:                    [ "inputbar", "listbox" ];
}

listbox {
    spacing:                     20px;
    padding:                     20px;
    orientation:                 vertical;
    background-color:            transparent;
    children:                    [ "message", "listview" ];
}

inputbar {
    enabled:                     true;
    orientation:                 horizontal;
    spacing:                     10px;
    padding:                     20px 30px;
    background-color:            transparent;
    background-image:            url("~/.config/rofi/images/up.png", width);
    text-color:                  @fg0;
    children:                    [ "textbox-prompt-colon", "entry", "dummy", "mode-switcher" ];
}
textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    str:                         "";
    padding:                     12px 15px;
    border-radius:               100%;
    background-color:            transparent;
    text-color:                  @bg4;
}
entry {
    enabled:                     true;
    expand:                      false;
    width:                       250px;
    padding:                     12px 16px;
    border-radius:               100%;
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      text;
    placeholder:                 "Search";
    placeholder-color:           @fg1;
}
dummy {
    expand:                      true;
    background-color:            transparent;
}

mode-switcher{
    enabled:                     true;
    spacing:                     10px;
    background-color:            transparent;
}
button {
    width:                       45px;
    padding:                     12px;
    border-radius:               100%;
    background-color:            transparent;
    text-color:                  @fg0;
    cursor:                      pointer;
}
button selected {
    text-color:                  @bg4;
}

listview {
    enabled:                     true;
    columns:                     2;
    lines:                       7;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    spacing:                     10px;
    background-color:            transparent;
    text-color:                  @fg0;
}

element {
    enabled:                     true;
    spacing:                     10px;
    padding:                     4px;
    background-color:            transparent;
    cursor:                      pointer;
}
element normal active {
    text-color:                  @bg1;
}
element selected normal, element selected active {
    border-radius:		 5px;
    background-color:            @bg1;
    text-color:                  @bg3;
}
element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        30px;
    cursor:                      pointer;
}
element-text {
    background-color:            transparent;
    text-color:                  @fg0;
    cursor:                      pointer;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

message {
    background-color:            transparent;
}
textbox {
    padding:                     12px;
    border-radius:               7px;
    background-color:            @bg2;
    text-color:                  @fg0;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}
error-message {
    padding:                     12px;
    border-radius:               20px;
    background-color:            @bg1;
    text-color:                  @fg0;
}
