
@import	"~/.config/rofi/themes/main.rasi"

* {
    background-color:   transparent;
    font:		@main-font;
    text-color:		@tp0;
}

window { 
    location:		center;
    width:		220px;
    border:		2.5px;
    border-radius:	15px;
    border-color:	@bg3;
    background-color:   @bg0;
}

mainbox {
    padding:		7px;
}

inputbar {
    //background-color:   @bg1;

   // border:         2px;
   // border-radius:  16px;

}

prompt {
    text-color: @fg0;
    padding:	0px 0px 0px 15px;
}

listview {
    lines:		5;
    columns:		1;
    expand:		false;
    fixed-height:	false;
    padding:            10px;
}

element {
    padding:		11px 16px;
    border-radius:	6px;
}

element selected normal {
    background-color:   @bg2;
    border:		2px;
    border-color:	@bg4;
}

element-text {
    text-color:		@fg0;
    horizontal-align:	0.5;
}



