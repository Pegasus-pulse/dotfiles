##+++System Control+++##

# Reload sxhkdrc
super + shift + x
  pkill -usr1 -x sxhkd; notify-send 'sxhkd' 'Reloaded config'

# Start v2ray(proxy)
super + F3
  exec ~/.config/scripts/startv2ray.sh

# Lock the screen
super + l
  exec betterlockscreen -l dimblur --off 5

# Start a terminal
super + Return
  exec kitty

# Run Rofi app menu
super + space
  exec rofi -disable-history -show-icons -show

# Powermenu(custom rofi menu)
super + x
  exec ~/.config/scripts/power-menu.sh

# Clipboard
super + v
  /usr/bin/diodon

# Capture Screenshots
Print
  exec flameshot gui


# i3 workspaces
super + {1-9}
  i3-msg workspace {1-9}

alt + {1,2,3,4,5,6,7,8,9}
  i3-msg workspace {10,11,12,13,14,15,16,17,18}

super + shift + {1-9}
  i3-msg move container to workspace number {1-9}

alt + shift + {1,2,3,4,5,6,7,8,9}
  i3-msg move container to workspace number {10,11,12,13,14,15,16,17,18} 


# Open VSCodium
alt + c 
  exec codium

# Open Librewolf
alt + f
  exec librewolf

# Open Brave
alt + b
  exec brave-browser --incognito

# Open Thunar
alt + t
  exec thunar

# Open Geany
alt + k
  exec geany

# Open Lutris
alt + g
  env GTK_THEME=VALYRIAN-Blue-Steel lutris

# Open local-music-player
alt + F8
  kitty --class "ncmpcpp" -e ncmpcpp

# Open Youtube-Music
alt + F4
  exec /opt/Youtube-Music_pear/YouTube-Music-3.11.0.AppImage

# Open task-manager
alt + m
  kitty --class "btop" -e btop

# Open terminal file-manager
alt + l
  kitty --class "lf" -e lf

# Open lazydocker
super + F9
  kitty --class "lazydocker" -e lazydocker


###Audio###

# Increase/Decrease Volume
#alt + {minus, equal}
#  pactl set-sink-volume @DEFAULT_SINK@ {-2%, +2%}

# Mute Volume
#alt + p
#  pactl set-sink-mute @DEFAULT_SINK@ toggle

# Decrease volume
alt + minus
  exec ~/.config/scripts/changevolume.sh down

# Increase volume
alt + equal
  exec ~/.config/scripts/changevolume.sh up

# Mute Volume
alt + p
  exec ~/.config/scripts/changevolume.sh mute

# Media Controls
alt + F1
  playerctl -a -i "mpd" previous
  
alt + F2
  playerctl -a -i "mpd" play-pause

alt + F3
  playerctl -a -i "mpd" next

alt + F9
  playerctl -p "mpd" previous
  
alt + F10
  playerctl -p "mpd" play-pause

alt + F11
  playerctl -p "mpd" next

alt + F12
  playerctl -p "mpd" stop

